
pipeline {
    agent {
        label 'docker-builder'
    }

    tools {
        maven 'Maven3'
    }

    environment {
        BUILDKIT_HOST = 'tcp://buildkit:1234'
        IMAGE_NAME = 'docker.io/oumayma15/student-management'
    }

    stages {

        stage('Checkout GitHub') {
            steps {
                checkout scm
            }
        }

        stage('Build Maven') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Verify JAR') {
            steps {
                sh 'ls -lh target/*.jar'
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        export DOCKER_CONFIG="$(mktemp -d)"
                        chmod 700 "$DOCKER_CONFIG"
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                        AUTH=$(printf '%s:%s' \
                            "$DOCKERHUB_USER" \
                            "$DOCKERHUB_TOKEN" \
                            | base64 | tr -d '\\n')

                        printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' \
                            "$AUTH" > "$DOCKER_CONFIG/config.json"

                        chmod 600 "$DOCKER_CONFIG/config.json"

                        buildctl --addr "$BUILDKIT_HOST" build \
                            --frontend dockerfile.v0 \
                            --local context=. \
                            --local dockerfile=. \
                            --output "type=image,name=$IMAGE_NAME:latest,push=true"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI : Image construite et publiée sur Docker Hub !'
        }

        failure {
            echo 'CI : Échec de la pipeline.'
        }
    }
}
