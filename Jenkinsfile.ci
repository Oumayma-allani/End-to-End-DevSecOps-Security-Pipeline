
pipeline {
    agent {
        label 'docker-builder'
    }

    tools {
        maven 'Maven3'
    }

    environment {
        BUILDKIT_HOST = 'tcp://buildkit:1234'
        IMAGE_NAME = 'docker.io/oumayma15/student-management'
        K8S_SERVER = 'https://host.docker.internal:59061'
        K8S_NAMESPACE = 'student-management'
    }

    stages {

        stage('Checkout GitHub') {
            steps {
                checkout scm
            }
        }

        // DEVELOPMENT: STATIC CODE ANALYSIS
        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        mvn -B -DskipTests compile

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.projectKey=student-management \
                          -Dsonar.projectName=student-management \
                          -Dsonar.host.url=http://sonarqube:9000 \
                          -Dsonar.token="$SONAR_TOKEN"
                    '''
                }
            }
        }

        // DEVELOPMENT: SOFTWARE COMPOSITION ANALYSIS
        stage('OWASP Dependency-Check') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'nvd-api-key',
                        variable: 'NVD_API_KEY'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        mvn org.owasp:dependency-check-maven:13.0.0:check \
                          -DnvdApiKeyEnvironmentVariable=NVD_API_KEY \
                          -DnvdApiDelay=6000 \
                          -DnvdMaxRetryCount=10 \
                          -DfailBuildOnCVSS=11 \
                          -Dformat=HTML

                        echo "OWASP Dependency-Check : analyse terminée."
                    '''
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'target/dependency-check-report.html',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        // BUILD MAVEN
        stage('Build Maven') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Verify JAR') {
            steps {
                sh 'ls -lh target/*.jar'
            }
        }

        // DOCKER BUILD AND PUSH
        stage('Build and Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        export DOCKER_CONFIG="$(mktemp -d)"
                        chmod 700 "$DOCKER_CONFIG"
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                        AUTH=$(printf '%s:%s' \
                            "$DOCKERHUB_USER" \
                            "$DOCKERHUB_TOKEN" \
                            | base64 | tr -d '\\n')

                        printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' \
                            "$AUTH" > "$DOCKER_CONFIG/config.json"

                        chmod 600 "$DOCKER_CONFIG/config.json"

                        buildctl --addr "$BUILDKIT_HOST" build \
                            --frontend dockerfile.v0 \
                            --local context=. \
                            --local dockerfile=. \
                            --output "type=image,name=$IMAGE_NAME:latest,push=true"
                    '''
                }
            }
        }

        // DEPLOYMENT TO KUBERNETES
        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'kubernetes-deployer-token',
                        variable: 'K8S_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        kubectl \
                          --server="$K8S_SERVER" \
                          --insecure-skip-tls-verify \
                          --token="$K8S_TOKEN" \
                          -n "$K8S_NAMESPACE" \
                          set image deployment/student-management \
                          student-management="$IMAGE_NAME:latest"

                        kubectl \
                          --server="$K8S_SERVER" \
                          --insecure-skip-tls-verify \
                          --token="$K8S_TOKEN" \
                          -n "$K8S_NAMESPACE" \
                          rollout restart deployment/student-management

                        kubectl \
                          --server="$K8S_SERVER" \
                          --insecure-skip-tls-verify \
                          --token="$K8S_TOKEN" \
                          -n "$K8S_NAMESPACE" \
                          rollout status deployment/student-management \
                          --timeout=180s
                    '''
                }
            }
        }

        // ACCEPTANCE: NMAP SECURITY SCANNING
        stage('Nmap Security Scan') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'kubernetes-deployer-token',
                        variable: 'K8S_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        mkdir -p reports

                        echo "Starting Kubernetes port-forward..."

                        kubectl \
                          --server="$K8S_SERVER" \
                          --insecure-skip-tls-verify \
                          --token="$K8S_TOKEN" \
                          -n "$K8S_NAMESPACE" \
                          port-forward --address 127.0.0.1 \
                          svc/student-management 8089:8089 \
                          > reports/port-forward.log 2>&1 &

                        PF_PID=$!

                        trap 'kill "$PF_PID" 2>/dev/null || true' EXIT

                        echo "Waiting for port-forward..."

                        READY=0

                        for i in $(seq 1 15); do
                            if grep -q "Forwarding from 127.0.0.1:8089" \
                                reports/port-forward.log; then
                                READY=1
                                break
                            fi

                            if ! kill -0 "$PF_PID" 2>/dev/null; then
                                echo "Port-forward stopped unexpectedly."
                                cat reports/port-forward.log
                                exit 1
                            fi

                            sleep 2
                        done

                        if [ "$READY" -ne 1 ]; then
                            echo "Port-forward did not become ready."
                            cat reports/port-forward.log
                            exit 1
                        fi

                        echo "Running Nmap Security Scan..."

                        nmap -sT -sV -Pn \
                          -p 8089 \
                          -oN reports/nmap-scan.txt \
                          -oX reports/nmap-scan.xml \
                          -oG reports/nmap-scan.gnmap \
                          127.0.0.1

                        echo "Checking expected port..."

                        if ! grep -q "8089/open/tcp" \
                            reports/nmap-scan.gnmap; then
                            echo "SECURITY CHECK FAILED: Port 8089 is not open."
                            exit 1
                        fi

                        echo "Nmap Security Scan completed successfully."
                    '''
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'reports/nmap-scan.*',
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    // EMAIL NOTIFICATIONS
    post {
        success {
            echo 'CI/CD SUCCESS : Image publiée sur Docker Hub et application déployée sur Kubernetes !'

            emailext(
                subject: "SUCCESS - Jenkins CI/CD - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    Pipeline DevSecOps exécuté avec succès !

                    Projet : ${env.JOB_NAME}
                    Build : #${env.BUILD_NUMBER}
                    Statut : SUCCESS

                    Security:
                    - SonarQube Analysis
                    - OWASP Dependency-Check
                    - Nmap Security Scan

                    Jenkins : ${env.BUILD_URL}
                """,
                to: 'allanimimou@gmail.com'
            )
        }

        failure {
            echo 'CI/CD FAILED : Vérifier les logs Jenkins.'

            emailext(
                subject: "FAILURE - Jenkins CI/CD - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    Le pipeline DevSecOps a échoué.

                    Projet : ${env.JOB_NAME}
                    Build : #${env.BUILD_NUMBER}
                    Statut : FAILURE

                    Consulter les logs : ${env.BUILD_URL}
                """,
                to: 'allanimimou@gmail.com'
            )
        }
    }
}
