
pipeline {
    agent {
        label 'docker-builder'
    }

    tools {
        maven 'Maven3'
    }

    environment {
        BUILDKIT_HOST = 'tcp://buildkit:1234'
    }

    stages {
        stage('Checkout GitHub') {
            steps {
                checkout scm
            }
        }

        stage('Build Maven') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Verify JAR') {
            steps {
                sh 'ls -lh target/*.jar'
            }
        }

        
stage('Build and Push Docker Image') {
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'dockerhub-credentials',
                usernameVariable: 'DOCKERHUB_USER',
                passwordVariable: 'DOCKERHUB_TOKEN'
            )
        ]) {
            sh '''
                set +x
                set -eu

                mkdir -p "$WORKSPACE/.docker-buildkit"
                chmod 700 "$WORKSPACE/.docker-buildkit"

                AUTH=$(printf '%s:%s' "$DOCKERHUB_USER" "$DOCKERHUB_TOKEN" | base64 | tr -d '\\n')

                printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' "$AUTH" \
                    > "$WORKSPACE/.docker-buildkit/config.json"

                chmod 600 "$WORKSPACE/.docker-buildkit/config.json"

                export DOCKER_CONFIG="$WORKSPACE/.docker-buildkit"

                trap 'rm -rf "$WORKSPACE/.docker-buildkit"' EXIT

                buildctl --addr "$BUILDKIT_HOST" build \
                    --frontend dockerfile.v0 \
                    --local context=. \
                    --local dockerfile=. \
                    --output type=image,name=docker.io/oumayma15/student-management:latest,push=true

                echo "Image publiée sur Docker Hub."
            '''
        }
    }
}

    post {
        success {
            echo 'CI : Maven et BuildKit exécutés avec succès !'
        }
        failure {
            echo 'CI : La pipeline a échoué.'
        }
    }
}

