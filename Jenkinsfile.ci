
pipeline {
    agent {
        label 'docker-builder'
    }

    tools {
        maven 'Maven3'
    }

    environment {
        BUILDKIT_HOST = 'tcp://buildkit:1234'
    }

    stages {
        stage('Checkout GitHub') {
            steps {
                checkout scm
            }
        }

        stage('Build Maven') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Verify JAR') {
            steps {
                sh 'ls -lh target/*.jar'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    buildctl --addr "$BUILDKIT_HOST" build \
                      --frontend dockerfile.v0 \
                      --local context=. \
                      --local dockerfile=. \
                      --output type=oci,dest=student-management.tar
                '''
            }
        }

        stage('Verify Image') {
            steps {
                sh 'ls -lh student-management.tar'
            }
        }
    }

    post {
        success {
            echo 'CI : Maven et BuildKit exécutés avec succès !'
        }
        failure {
            echo 'CI : La pipeline a échoué.'
        }
    }
}

